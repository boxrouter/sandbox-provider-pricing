{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:boxrouter:sandbox-provider-pricing:result",
  "title": "Sandbox price result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "provider",
    "label",
    "total",
    "currency",
    "basis",
    "lines",
    "reported",
    "held_back_by",
    "excluded",
    "revisit",
    "final",
    "versions",
    "steps",
    "as_of"
  ],
  "properties": {
    "provider": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "label": { "enum": ["reported", "calculated", "unknown"] },
    "total": {
      "anyOf": [
        { "$ref": "#/$defs/total" },
        { "type": "null" }
      ]
    },
    "currency": { "const": "USD" },
    "basis": { "enum": ["list_price_usage", "provider_reported"] },
    "lines": {
      "type": "array",
      "items": { "$ref": "#/$defs/line" }
    },
    "reported": {
      "anyOf": [
        { "$ref": "#/$defs/reported" },
        { "type": "null" }
      ]
    },
    "held_back_by": {
      "type": "array",
      "items": { "$ref": "#/$defs/held_back" }
    },
    "excluded": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "final": {
      "description": "Whether the operational revisit window is closed or the sandbox was never created; this is not a provider guarantee of irrevocable finality.",
      "type": "boolean"
    },
    "revisit": {
      "anyOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["after", "until", "interval_s", "next_read_at"],
          "properties": {
            "after": { "$ref": "#/$defs/timestamp" },
            "until": { "$ref": "#/$defs/timestamp" },
            "interval_s": { "type": "integer", "minimum": 1 },
            "next_read_at": { "$ref": "#/$defs/timestamp" }
          }
        }
      ]
    },
    "versions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["package", "rules", "prices"],
      "properties": {
        "package": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "rules": { "type": "integer", "minimum": 1 },
        "prices": { "type": ["string", "null"] }
      }
    },
    "steps": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence", "times", "usage", "rated"],
      "properties": {
        "evidence": { "type": "object" },
        "times": {
          "type": "object",
          "additionalProperties": false,
          "required": ["start", "end"],
          "properties": {
            "start": { "$ref": "#/$defs/time_value" },
            "end": { "$ref": "#/$defs/time_value" }
          }
        },
        "sandbox_start": { "$ref": "#/$defs/time_value" },
        "sandbox_end": { "$ref": "#/$defs/time_value" },
        "usage": {
          "type": "object",
          "additionalProperties": false,
          "required": ["low", "high"],
          "properties": {
            "low": { "type": "object" },
            "high": { "type": "object" }
          }
        },
        "rated": {
          "type": "object",
          "additionalProperties": false,
          "required": ["low", "high"],
          "properties": {
            "low": { "type": "object" },
            "high": { "type": "object" }
          }
        }
      }
    },
    "as_of": { "$ref": "#/$defs/timestamp" }
  },
  "allOf": [
    {
      "if": { "properties": { "label": { "const": "unknown" } }, "required": ["label"] },
      "then": { "properties": { "total": { "type": "null" } } },
      "else": { "properties": { "total": { "$ref": "#/$defs/total" } } }
    },
    {
      "if": { "properties": { "label": { "const": "reported" } }, "required": ["label"] },
      "then": {
        "properties": { "basis": { "const": "provider_reported" }, "lines": { "maxItems": 0 } },
        "not": { "properties": { "reported": { "type": "null" } }, "required": ["reported"] }
      },
      "else": { "properties": { "basis": { "const": "list_price_usage" } } }
    }
  ],
  "$defs": {
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]+)?(Z|[+-]([01][0-9]|2[0-3]):[0-5][0-9])$"
    },
    "decimal": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
    },
    "range": {
      "type": "object",
      "additionalProperties": false,
      "required": ["low", "high"],
      "properties": {
        "low": { "$ref": "#/$defs/decimal" },
        "high": { "$ref": "#/$defs/decimal" }
      }
    },
    "total": { "$ref": "#/$defs/range" },
    "quantity": { "$ref": "#/$defs/decimal" },
    "line": {
      "type": "object",
      "additionalProperties": false,
      "required": ["what", "quantity", "unit", "rate", "amount", "quantity_source"],
      "properties": {
        "what": { "enum": ["cpu", "memory", "disk", "gpu", "creation", "egress", "snapshot_storage"] },
        "quantity": { "$ref": "#/$defs/quantity" },
        "unit": { "type": "string", "minLength": 1 },
        "rate": { "$ref": "#/$defs/decimal" },
        "amount": { "$ref": "#/$defs/quantity" },
        "quantity_source": {
          "enum": ["provider", "measured", "recorded", "published", "calculated", "unknown"]
        }
      }
    },
    "reported": {
      "type": "object",
      "additionalProperties": false,
      "required": ["usd", "source", "how"],
      "properties": {
        "usd": { "$ref": "#/$defs/decimal" },
        "source": { "type": "string", "minLength": 1 },
        "how": { "type": "string", "minLength": 1 },
        "taken_at": {
          "description": "Present only when the figure is the provider's last read taken before it deleted its record: the time of that read. The sandbox's final usage can exceed it by the seconds between the read and the delete.",
          "type": "string",
          "minLength": 1
        }
      }
    },
    "held_back": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "resource", "text"],
      "properties": {
        "code": { "enum": ["unreported_quantity", "no_rate", "missing_input", "preparation_cost_unavailable"] },
        "resource": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "text": { "type": "string", "minLength": 1 }
      }
    },
    "time_value": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "source", "how"],
      "properties": {
        "value": { "anyOf": [{ "$ref": "#/$defs/timestamp" }, { "type": "null" }] },
        "source": { "enum": ["provider", "measured", "recorded", "published", "calculated", "unknown"] },
        "how": { "type": "string", "minLength": 1 }
      }
    }
  }
}
